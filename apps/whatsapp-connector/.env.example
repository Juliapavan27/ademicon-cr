PORT=3001
# Shared secret — must match the same value set on the whatsapp-webhook Edge
# Function's WHATSAPP_CONNECTOR_SECRET secret.
WHATSAPP_CONNECTOR_SECRET=
# https://<project-ref>.supabase.co/functions/v1/whatsapp-webhook
SUPABASE_WEBHOOK_URL=
# Where Baileys persists the WhatsApp session. Point this at a persistent
# volume in production so redeploys don't require re-scanning the QR code.
WHATSAPP_AUTH_DIR=./auth_state
